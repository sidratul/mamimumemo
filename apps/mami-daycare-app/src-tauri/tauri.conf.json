{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mami Daycare",
  "version": "1.0.0",
  "identifier": "com.mami.daycare",
  "build": {
    "beforeDevCommand": "pnpm web",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "pnpm web:export",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mami Daycare",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/images/icon.png"
    ]
  }
}

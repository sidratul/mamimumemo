{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@mami/core": ["../../packages/core/src/index"],
      "@mami/ui": ["../../packages/ui/src/index"],
      "@mami/graphql": ["../../packages/graphql/src/index"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}

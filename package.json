{
  "name": "daycare-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "pnpm admin:start",
    "admin:start": "pnpm --filter @mami/admin-app start",
    "admin:check": "pnpm --filter @mami/admin-app check",
    "admin:build:ios:preview": "pnpm --filter @mami/admin-app build:ios:preview",
    "admin:build:android:preview": "pnpm --filter @mami/admin-app build:android:preview",
    "admin:build:android:preview:local": "pnpm --filter @mami/admin-app build:android:preview:local",
    "admin:build:ios:production": "pnpm --filter @mami/admin-app build:ios:production",
    "admin:build:android:production": "pnpm --filter @mami/admin-app build:android:production",
    "admin:build:android:production:local": "pnpm --filter @mami/admin-app build:android:production:local",
    "parent:start": "pnpm --filter @mami/parent-app start",
    "daycare:start": "pnpm --filter @mami/daycare-app start",
    "daycare:desktop:dev": "pnpm --filter @mami/daycare-app desktop:dev",
    "daycare:desktop:build": "pnpm --filter @mami/daycare-app desktop:build",
    "build:packages": "pnpm --filter @mami/core build && pnpm --filter @mami/ui build && pnpm --filter @mami/graphql build"
  }
}
